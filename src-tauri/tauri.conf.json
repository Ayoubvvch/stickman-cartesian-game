{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stickman Cartesian Frame",
  "version": "3.0.0",
  "identifier": "com.acmods.stickman-cartesian",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stickman · Orthonormal Cartesian Frame v3.0",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
